# =============================================================================
# Production checklist — DO NOT put real secrets in this file.
#
# Deployed API (Railway) reads environment variables from the Railway dashboard.
# This file is not used at runtime in production. Keep it as a reference of
# which keys to configure on Railway (and matching public keys on Vercel if any).
#
# Local development uses apps/api/.env.local instead.
# =============================================================================
#
# Required on Railway:
#   DATABASE_URL
#   PORT                          (Railway usually sets this)
#   WEB_ORIGIN                    (e.g. https://foresteacafe.com)
#   INTERNAL_API_SECRET           (must match the web app)
#   STRIPE_SECRET_KEY             (live sk_live_...)
#   STRIPE_PUBLISHABLE_KEY        (live pk_live_...)
#   TAX_RATE                      (e.g. 0.101)
#
# Optional — email (Resend):
#   RESEND_API_KEY
#   ORDER_EMAIL_FROM
#   ORDER_EMAIL_REPLY_TO
#
# Optional — SMS (Twilio):
#   TWILIO_ACCOUNT_SID
#   TWILIO_AUTH_TOKEN
#   TWILIO_FROM_NUMBER
#   TWILIO_MESSAGING_SERVICE_SID
