ORDER_EMAIL_FROM="Forestea <onboarding@resend.dev>"
ORDER_EMAIL_REPLY_TO=""

# Order confirmation SMS (Twilio). Leave TWILIO_ACCOUNT_SID empty to disable SMS.
# Set TWILIO_MESSAGING_SERVICE_SID instead of TWILIO_FROM_NUMBER once A2P 10DLC
# registration is approved.
